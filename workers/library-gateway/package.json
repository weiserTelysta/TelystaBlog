{
  "name": "telysta-library-gateway",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types --env-interface LibraryGatewayEnv -c wrangler.jsonc -c ../console/wrangler.jsonc",
    "check": "npm run types && tsc --noEmit",
    "test": "node scripts/build-tests.mjs && node --test tests/*.test.mjs",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.162.0",
    "typescript": "6.0.3",
    "@types/node": "22.20.1"
  }
}
