{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "telysta-library-gateway",
  "main": "src/index.ts",
  "account_id": "c3a43d4042720d333a0dbb0afdf986fb",
  "compatibility_date": "2026-11-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "secrets": {
    "required": [
      "ANONYMOUS_QUOTA_SECRET"
    ]
  },
  "vars": {
    "CATALOG_KEY": "gateway/catalog-7c2802c694b0be34eff3d5b96b3f6a31adc72930de7f0d9ca786c2b7d786a194.json",
    "ALLOWED_ORIGINS": "https://telysta.com"
  },
  "r2_buckets": [
    {
      "binding": "LIBRARY_BUCKET",
      "bucket_name": "telysta-library"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ANONYMOUS_DOWNLOADS",
        "class_name": "AnonymousDownloads"
      }
    ]
  },
  "migrations": [
    {
      "tag": "anonymous-downloads-v1",
      "new_sqlite_classes": [
        "AnonymousDownloads"
      ]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "routes": [
    {
      "pattern": "library-files.telysta.com",
      "custom_domain": true
    },
    {
      "pattern": "library-gateway.telysta.com",
      "custom_domain": true
    }
  ],
  "services": [
    {
      "binding": "AUTH_SERVICE",
      "service": "telysta-console",
      "entrypoint": "AuthService"
    }
  ]
}
