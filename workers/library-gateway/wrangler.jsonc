{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "telysta-library-gateway",
  "main": "src/index.ts",
  "account_id": "c3a43d4042720d333a0dbb0afdf986fb",
  "compatibility_date": "2026-11-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "vars": {
    "CATALOG_KEY": "gateway/catalog-ea08e32e30f1c3c23ba6cc70a6b6fad6e43f090421ffebce63eee49b5f1d3371.json",
    "ALLOWED_ORIGINS": "https://telysta.com"
  },
  "r2_buckets": [
    {
      "binding": "LIBRARY_BUCKET",
      "bucket_name": "telysta-library"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "routes": [
    {
      "pattern": "library-files.telysta.com",
      "custom_domain": true
    },
    {
      "pattern": "library-gateway.telysta.com",
      "custom_domain": true
    }
  ],
  "services": [
    {
      "binding": "AUTH_SERVICE",
      "service": "telysta-console",
      "entrypoint": "AuthService"
    }
  ]
}
