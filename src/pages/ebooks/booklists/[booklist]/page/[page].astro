---
import EbookShelf from '../../../../../components/ebooks/EbookShelf.astro';
import { EBOOKS_PAGE_SIZE } from '../../../../../config/library';
import { getPublishedEbookEntries } from '../../../../../lib/ebooks/ebooks';
import { shelfBooklists } from '../../../../../lib/ebooks/shelf';
export async function getStaticPaths() {
	const books = (await getPublishedEbookEntries({ includeProtected: true })).map(book => book.data);
	return shelfBooklists(books).flatMap(item => Array.from({ length: Math.max(0, Math.ceil(item.count / EBOOKS_PAGE_SIZE) - 1) }, (_, index) => ({ params: { booklist: item.slug, page: String(index + 2) }, props: { page: index + 2, booklist: item.code } })));
}
const { page, booklist } = Astro.props;
---
<EbookShelf page={page} booklist={booklist} />
