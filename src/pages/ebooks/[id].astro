---
import { render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { EBOOK_PAGE_CONFIG as copy } from '../../config/pages/ebooks';
import { SITE_CONFIG } from '../../config/site';
import { getPublishedEbookEntries } from '../../lib/ebooks/ebooks';
import '../../styles/ebooks.scss';
export async function getStaticPaths() {
	return (await getPublishedEbookEntries()).map(entry => ({ params: { id: entry.data.id }, props: { entry } }));
}
type Props = { entry: CollectionEntry<'ebooks'> };
const { entry } = Astro.props;
const book = entry.data;
const { Content } = await render(entry);
---
<Layout title={`${book.title} - ${SITE_CONFIG.name}`} description={book.description} shareImage={book.cover} shareImageAlt={book.title} starfieldVariant="subtle">
	<main class="ebook-page">
		<a class="ebook-back" href="/ebooks/">← {copy.backLabel}</a>
		<div class="ebook-detail">
			{book.cover ? <img class="ebook-detail__cover" src={book.cover} alt={`${book.title}封面`} width="240" height="360" decoding="async" /> : <div class="ebook-cover-placeholder ebook-detail__cover">{book.title}</div>}
			<div>
				<header class="ebook-header"><h1>{book.title}</h1></header>
				<dl>
					<dt>作者／编者</dt><dd>{book.authors.join('、')}{book.authorStatus === 'partial-collection' && ' 等'}</dd>
					{book.translator && <><dt>译者</dt><dd>{book.translator}</dd></>}
					{book.publisher && <><dt>出版社</dt><dd>{book.publisher}</dd></>}
					{book.publicationYear && <><dt>出版年份</dt><dd>{book.publicationYear}</dd></>}
					{book.clcCode && <><dt>分类</dt><dd>{book.clcCode} · {book.clcName}</dd></>}
				</dl>
				{book.authorStatus === 'partial-collection' && <p class="ebook-card__authors">合集含多位作者，此处列出已核实的署名。</p>}
				<h2>{copy.downloadLabel}</h2>
				<ul class="ebook-formats">{book.files.map(file => <li><a href={file.href} target="_blank" rel="noopener noreferrer" download aria-label={`下载 ${book.title}（${file.format}）`}>{file.format}{file.bytes ? ` · ${(file.bytes / 1024 / 1024).toFixed(1)} MB` : ''}</a></li>)}</ul>
			</div>
		</div>
		<div class="prose ebook-body"><Content /></div>
	</main>
</Layout>
