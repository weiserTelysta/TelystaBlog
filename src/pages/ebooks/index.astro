---
import Layout from '../../layouts/Layout.astro';
import EbookCard from '../../components/ebooks/EbookCard.astro';
import { EBOOK_PAGE_CONFIG as copy } from '../../config/pages/ebooks';
import { getPublishedEbookEntries, toEbook } from '../../lib/ebooks/ebooks';
import '../../styles/ebooks.scss';
const books = (await getPublishedEbookEntries()).map(entry => toEbook(entry.data));
---
<Layout title={copy.meta.title} description={copy.meta.description} starfieldVariant="subtle">
	<main class="ebook-page">
		<header class="ebook-header">
			<p class="ebook-eyebrow">{copy.hero.eyebrow}</p>
			<h1>{copy.hero.title}</h1>
			<p>{copy.hero.description}</p>
		</header>
		{books.length ? <ul class="ebook-grid">{books.map(book => <li><EbookCard book={book} /></li>)}</ul> : <p class="ebook-empty">{copy.empty}</p>}
	</main>
</Layout>
