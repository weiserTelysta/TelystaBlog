---
import { getCollection, render } from 'astro:content';
import ArticleAside from '../../components/article/ArticleAside.astro';
import ArticleComments from '../../components/article/ArticleComments.astro';
import CloudComments from '../../components/CloudComments.astro';
import ArticleHeader from '../../components/article/ArticleHeader.astro';
import ArticleSeriesNav from '../../components/article/ArticleSeriesNav.astro';
import Layout from '../../layouts/Layout.astro';
import { ARTICLE_PAGE_CONFIG } from '../../config/pages/article';
import {
	getSeriesNavigation,
	toPostListItem,
	type PostEntry,
	type SeriesNavigation,
} from '../../lib/blogPosts';
import { getBlogSeriesById } from '../../lib/blogSeriesUtils';
import { SITE_CONFIG } from '../../config/site';
import publishedAuthors from '../../../data/post-authors.json';
import { isPublishedPostAuthor } from '../../lib/postPublicationSource';
import 'katex/dist/katex.min.css';
import 'photoswipe/style.css';
import '../../components/article/ArticleImageViewer.scss';

export async function getStaticPaths() {
	const entries = (await getCollection('posts')) as PostEntry[];
	const publishedEntries = entries.filter((entry) => !entry.data.draft);
	const publishedPosts = publishedEntries.map(toPostListItem);

	return publishedEntries.map((entry, index) => ({
			params: { slug: entry.id },
			props: {
				entry,
				navigation: getSeriesNavigation(publishedPosts, publishedPosts[index]),
				seriesPostCount: entry.data.series
					? publishedEntries.filter((candidate) => candidate.data.series === entry.data.series).length
					: undefined,
			},
		}));
}

type Props = {
	entry: PostEntry;
	seriesPostCount?: number;
	navigation?: SeriesNavigation;
};

const { entry, seriesPostCount, navigation } = Astro.props as Props;
const post = toPostListItem(entry);
const attribution = (publishedAuthors as Record<string, { sha256: string; revision: number; author: unknown }>)[entry.id];
const publication = attribution?.sha256 === entry.data.sourceHash &&
	Number.isSafeInteger(attribution.revision) && attribution.revision > 0 && isPublishedPostAuthor(attribution.author)
	? { revision: attribution.revision, author: attribution.author } : undefined;
const author = publication?.author;
const series = getBlogSeriesById(post.series);
const { Content, headings } = await render(entry);
const articleTitle = post.title;
const tocHeadings = headings.filter(
	(heading) =>
		heading.depth >= ARTICLE_PAGE_CONFIG.toc.minDepth &&
		heading.depth <= ARTICLE_PAGE_CONFIG.toc.maxDepth,
);
const hasToc = tocHeadings.length >= ARTICLE_PAGE_CONFIG.toc.minHeadingCount;
---

<Layout
	title={`${post.title}${ARTICLE_PAGE_CONFIG.meta.titleSeparator}${SITE_CONFIG.name}`}
	description={post.description}
	shareImage={post.cover}
	shareImageAlt={post.title}
	article={{ title: articleTitle, publishedAt: post.publishedAt, updatedAt: post.updatedAt, tags: post.tags, author }}
	starfieldVariant="subtle"
>
	<main class="article-page">
		<article class="article-page__inner" data-telysta-post={entry.id} data-post-source={entry.data.sourceHash} data-post-revision={publication?.revision}>
			<ArticleHeader post={post} title={articleTitle} author={author} />

			<div class="article-page__body">
				<div class="article-page__content prose" data-article-content>
					<Content />
				</div>

				<ArticleSeriesNav series={series} postCount={seriesPostCount} navigation={navigation} />

				<CloudComments kind="post" id={`WEISER${entry.data.uuid}`} />
				<details class="legacy-comments"><summary>历史评论（GitHub）</summary><ArticleComments commentId={entry.data.commentId ?? entry.id} /></details>
			</div>

			{hasToc && <ArticleAside headings={tocHeadings} />}
		</article>
	</main>
</Layout>

<style lang="scss">
	.article-page {
		--article-reading-width: 760px;

		position: relative;
		z-index: 1;
		min-height: 100vh;
	}

	.article-page__inner {
		width: min(1380px, calc(100% - 48px));
		margin: 0 auto;
		padding-bottom: clamp(92px, 13vw, 150px);
	}

	.article-page__body {
		width: min(var(--article-reading-width), 100%);
		margin-inline: auto;
		min-height: 70vh;
	}

	.article-page__content {
		min-width: 0;
	}

	@media (max-width: 640px) {
		.article-page__inner {
			width: calc(100% - 32px);
		}
	}
</style>

<script>
	import { bindArticleCodeRuntime, initArticleCodeRuntime } from '../../lib/articleCodeRuntime';
	import { bindArticleImageRuntime, initArticleImageRuntime } from '../../lib/articleImageRuntime';

	initArticleCodeRuntime();
	bindArticleCodeRuntime();
	initArticleImageRuntime();
	bindArticleImageRuntime();
</script>
