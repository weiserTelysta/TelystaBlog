---
import { getCollection, render } from 'astro:content';
import ArticleAside from '../../components/article/ArticleAside.astro';
import ArticleHeader from '../../components/article/ArticleHeader.astro';
import ArticleSeriesNav from '../../components/article/ArticleSeriesNav.astro';
import Layout from '../../layouts/Layout.astro';
import { ARTICLE_PAGE_CONFIG } from '../../config/pages/article';
import {
	toPostListItem,
	type PostEntry,
} from '../../lib/blogPosts';
import { getBlogSeriesById } from '../../lib/blogSeriesUtils';
import { SITE_CONFIG } from '../../config/site';
import 'katex/dist/katex.min.css';

export async function getStaticPaths() {
	const entries = (await getCollection('posts')) as PostEntry[];

	return entries
		.filter((entry) => !entry.data.draft)
		.map((entry) => ({
			params: { slug: entry.id },
			props: { entry },
		}));
}

type Props = {
	entry: PostEntry;
};

const { entry } = Astro.props;
const post = toPostListItem(entry);
const series = getBlogSeriesById(post.series);
const { Content, headings } = await render(entry);
const tocHeadings = headings.filter(
	(heading) =>
		heading.depth >= ARTICLE_PAGE_CONFIG.toc.minDepth &&
		heading.depth <= ARTICLE_PAGE_CONFIG.toc.maxDepth,
);
const hasToc = tocHeadings.length >= ARTICLE_PAGE_CONFIG.toc.minHeadingCount;
---

<Layout
	title={`${post.title}${ARTICLE_PAGE_CONFIG.meta.titleSeparator}${SITE_CONFIG.name}`}
	description={post.description}
	starfieldVariant="subtle"
>
	<main class="article-page">
		<article class="article-page__inner">
			<ArticleHeader post={post} />

			<div class="article-page__body">
				<div class="article-page__content prose" data-article-content>
					<Content />
				</div>
			</div>

			{hasToc && <ArticleAside headings={tocHeadings} />}

			<ArticleSeriesNav series={series} />
		</article>
	</main>
</Layout>

<style lang="scss">
	.article-page {
		--article-reading-width: 760px;

		position: relative;
		z-index: 1;
		min-height: 100vh;
	}

	.article-page__inner {
		width: min(1380px, calc(100% - 48px));
		margin: 0 auto;
		padding-bottom: clamp(92px, 13vw, 150px);
	}

	.article-page__body {
		width: min(var(--article-reading-width), 100%);
		margin-inline: auto;
		min-height: 70vh;
	}

	.article-page__content {
		min-width: 0;
	}

	@media (max-width: 640px) {
		.article-page__inner {
			width: calc(100% - 32px);
		}
	}
</style>

<script>
	import { bindArticleCodeRuntime, initArticleCodeRuntime } from '../../lib/articleCodeRuntime';

	initArticleCodeRuntime();
	bindArticleCodeRuntime();
</script>
