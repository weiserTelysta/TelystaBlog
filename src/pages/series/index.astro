---
import Layout from '../../layouts/Layout.astro';
import FlowerOrnament from '../../components/site/FlowerOrnament.astro';
import { BLOG_CATEGORIES } from '../../config/content/blogCategories';
import { BLOG_SERIES, type BlogSeries } from '../../config/content/blogSeries';
import { SITE_CONFIG } from '../../config/site';
import { BLOG_PAGE_CONFIG } from '../../config/pages/blog';
import { getPostsBySeries, getPublishedPosts } from '../../lib/blogPosts';
import { buildSeriesHref } from '../../lib/blogSeriesUtils';

const copy = BLOG_PAGE_CONFIG.seriesIndex;
const posts = await getPublishedPosts();
const covers = import.meta.glob<string>('../../assets/images/series/*.webp', {
	query: '?url',
	import: 'default',
	eager: true,
});
const seriesEntries = BLOG_CATEGORIES.flatMap(category =>
	BLOG_SERIES.filter(item => item.category === category.id).map((item: BlogSeries) => ({
		...item,
		categoryLabel: category.subtitle,
		cover: item.cover || (item.artworkId ? covers[`../../assets/images/series/${item.artworkId}.webp`] : undefined),
		count: getPostsBySeries(posts, item.id).length,
	})),
).filter(item => item.count > 0);
---

<Layout title={`${copy.title} - ${SITE_CONFIG.name}`} description={copy.description} starfieldVariant="subtle">
	<main class="series-index">
		<h1 id="series-index-title"><FlowerOrnament tone="lilac">{copy.title}</FlowerOrnament></h1>
		<ul class="series-index__list" aria-labelledby="series-index-title">
			{seriesEntries.map((item, index) => (
				<li>
					<a class="series-index__card text-link" href={buildSeriesHref(item.id)} aria-labelledby={`series-title-${item.id}`}>
						<div class="series-index__cover" aria-hidden="true">
							{item.cover ? (
								<img src={item.cover} alt="" width="176" height="220" loading={index < 4 ? 'eager' : 'lazy'} decoding="async" />
							) : (
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
									<path d="M4 5.5c3.2-.5 5.9.2 8 2v12c-2.2-1.8-4.8-2.5-8-2zm16 0c-3.2-.5-5.9.2-8 2v12c2.2-1.8 4.8-2.5 8-2z"/>
								</svg>
							)}
						</div>
						<div class="series-index__summary">
							<strong id={`series-title-${item.id}`}>{item.title}</strong>
							<p>{item.description}</p>
							<div class="series-index__meta">
								<span>{item.categoryLabel}</span>
								<span>{copy.countLabel.replace('{count}', String(item.count))}</span>
							</div>
						</div>
					</a>
				</li>
			))}
		</ul>
	</main>
</Layout>

<style>
	.series-index {
		width: min(984px, calc(100% - 48px));
		min-height: 70vh;
		margin-inline: auto;
		padding: clamp(24px, 3.2vw, 44px) 0 72px;
	}
	h1 {
		margin: 0 0 clamp(16px, 2vw, 24px);
		color: var(--color-text);
		font: 580 1.125rem/1.4 var(--font-page-title);
	}
	.series-index__list {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 22px clamp(24px, 4vw, 48px);
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.series-index__card {
		display: grid;
		grid-template-columns: clamp(68px, 6.2vw, 88px) minmax(0, 1fr);
		gap: clamp(13px, 1.65vw, 20px);
		align-items: start;
		height: 100%;
		border-radius: var(--radius-control);
	}
	.series-index__cover {
		display: grid;
		place-items: center;
		aspect-ratio: 4 / 5;
		overflow: hidden;
		border-radius: var(--radius-control);
		background: color-mix(in srgb, var(--color-accent) 8%, var(--color-background-soft));
		color: var(--color-accent);
	}
	.series-index__cover img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.series-index__cover svg { width: 26px; }
	.series-index__summary { min-width: 0; padding-block-start: 6px; overflow-wrap: anywhere; }
	.series-index__summary strong {
		display: block;
		font-size: var(--type-body-size);
		line-height: 1.45;
		font-weight: 575;
	}
	.series-index__summary p {
		margin: .25rem 0 .42rem;
		color: var(--color-text-muted);
		font-size: var(--type-control-size);
		line-height: 1.6;
		text-wrap: pretty;
	}
	.series-index__meta {
		display: flex;
		flex-wrap: wrap;
		gap: .15rem .65rem;
		color: var(--color-accent);
		font-size: var(--type-meta-size);
	}
	@media (min-width: 901px) {
		.series-index__summary p { min-block-size: 3.2em; }
	}
	@media (max-width: 700px) {
		.series-index { width: calc(100% - 40px); }
		.series-index__list { grid-template-columns: minmax(0, 1fr); row-gap: 18px; }
	}
</style>
