---
import ArticlePostList from '../../components/article/ArticlePostList.astro';
import Layout from '../../layouts/Layout.astro';
import { ARTICLE_PAGE_CONFIG } from '../../config/pages/article';
import { BLOG_SERIES, type BlogSeries } from '../../config/content/blogSeries';
import { getPostsBySeries, getPublishedPosts } from '../../lib/blogPosts';
import { SITE_CONFIG } from '../../config/site';

export function getStaticPaths() {
	return BLOG_SERIES.map((series) => ({
		params: { series: series.id },
		props: { series },
	}));
}

type Props = {
	series: BlogSeries;
};

const { series } = Astro.props;
const allPosts = await getPublishedPosts();
const posts = getPostsBySeries(allPosts, series.id);
const postCountLabel = String(posts.length).padStart(2, '0');
---

<Layout
	title={`${series.title}${ARTICLE_PAGE_CONFIG.meta.titleSeparator}${SITE_CONFIG.name}`}
	description={series.description}
	starfieldVariant="subtle"
>
	<main class="series-page">
		<section class="series-page__inner" aria-labelledby="series-title">
			<header class="series-page__header">
				<p class="series-page__eyebrow">
					{ARTICLE_PAGE_CONFIG.series.pageLabel}
					<span aria-hidden="true">·</span>
					<span>{postCountLabel} {ARTICLE_PAGE_CONFIG.series.recordsLabel}</span>
				</p>
				<h1 id="series-title">{series.title}</h1>
			</header>

			{
				posts.length > 0 ? (
					<ArticlePostList posts={posts} />
				) : (
					<p class="series-page__empty">{ARTICLE_PAGE_CONFIG.series.emptyLabel}</p>
				)
			}
		</section>
	</main>
</Layout>

<style lang="scss">
	.series-page {
		position: relative;
		z-index: 1;
		min-height: 100vh;
	}

	.series-page__inner {
		display: grid;
		gap: clamp(32px, 4.5vw, 44px);
		width: min(760px, calc(100% - 48px));
		margin: 0 auto;
		padding: clamp(64px, 8vw, 96px) 0 clamp(92px, 13vw, 150px);
	}

	.series-page__header {
		display: grid;
		gap: 10px;
	}

	.series-page__eyebrow {
		display: flex;
		gap: 10px;
		align-items: baseline;
		margin: 0;
		color: rgba(156, 199, 232, 0.58);
		font-family: var(--type-display-label-font);
		font-size: var(--type-display-label-size);
		font-weight: var(--type-display-label-weight);
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.series-page__eyebrow > span:first-of-type {
		color: rgba(139, 149, 167, 0.4);
	}

	.series-page__eyebrow > span:last-of-type {
		color: rgba(139, 149, 167, 0.62);
	}

	.series-page__header h1 {
		margin: 0;
		color: rgba(237, 243, 251, 0.94);
		font-family: var(--type-index-title-font);
		font-size: clamp(2rem, 4.2vw, 3.1rem);
		font-weight: var(--type-index-title-weight);
		line-height: 1.14;
		letter-spacing: 0;
		overflow-wrap: anywhere;
	}

	.series-page__empty {
		margin: 0;
		padding: 28px 0;
		border-bottom: 1px solid rgba(255, 255, 255, 0.055);
		color: rgba(139, 149, 167, 0.72);
		line-height: 1.8;
	}

	@media (max-width: 640px) {
		.series-page__inner {
			width: min(100% - 32px, 720px);
			padding-top: 56px;
		}
	}
</style>
