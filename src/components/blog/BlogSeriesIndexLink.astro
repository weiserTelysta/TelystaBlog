---
import './BlogIndexControl.scss';
import { BLOG_PAGE_CONFIG } from '../../config/pages/blog';
const copy = BLOG_PAGE_CONFIG.seriesIndex;
---

<a class="blog-series-link blog-index-control" href="/series/" aria-label={copy.ariaLabel}>
	<span class="blog-index-control__label">{copy.entryLabel}</span>
	<span class="blog-index-control__title">{copy.allLabel}</span>
</a>
