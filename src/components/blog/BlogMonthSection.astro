---
import type { BlogMonthGroup } from '../../lib/blogPosts';
import BlogPostItem from './BlogPostItem.astro';

type Props = {
	monthGroup: BlogMonthGroup;
};

const { monthGroup } = Astro.props;
---

<section class="blog-month" aria-label={`${monthGroup.label} ${monthGroup.year}`}>
	<div class="blog-month__node" aria-hidden="true"></div>
	<ol class="blog-month__posts">
		{monthGroup.posts.map((post) => <BlogPostItem post={post} />)}
	</ol>
</section>

<style lang="scss">
	.blog-month {
		position: relative;
		display: grid;
		grid-template-columns: 16px minmax(0, 1fr);
		column-gap: 14px;
	}

	.blog-month::before {
		position: absolute;
		top: 15px;
		bottom: calc(-1 * var(--month-stack-gap));
		left: 7.5px;
		width: 1px;
		background: linear-gradient(
			180deg,
			rgba(156, 199, 232, 0.24),
			rgba(156, 199, 232, 0.07)
		);
		content: "";
	}

	.blog-month:last-child::before {
		bottom: 0;
		background: linear-gradient(180deg, rgba(156, 199, 232, 0.2), transparent);
	}

	.blog-month__node {
		position: relative;
		z-index: 1;
		grid-column: 1;
		grid-row: 1;
		width: 14px;
		height: 14px;
		margin-top: 0.55rem;
		border: 1px solid rgba(156, 199, 232, 0.42);
		border-radius: 50%;
		background:
			radial-gradient(circle, rgba(216, 222, 233, 0.5) 0 1.25px, transparent 1.75px),
			var(--color-background);
		box-shadow: 0 0 0 4px rgba(7, 10, 16, 0.86);
		justify-self: center;
	}

	.blog-month__posts {
		display: grid;
		grid-column: 2;
		grid-row: 1;
		gap: clamp(24px, 3.4vw, 30px);
		min-width: 0;
		margin: 0;
		padding: 0;
		list-style: none;
	}
</style>
