---
import type { PostListItem } from '../../lib/blogPosts';
import { buildCategoryHref } from '../../lib/blogCategoryUtils';
import { formatFullDate, formatPostDate } from '../../lib/blogPosts';

type Props = {
	post: PostListItem;
};

const { post } = Astro.props;
const visibleTags = post.tags.slice(0, 2);
---

<li class="blog-post">
	<article>
		<h3>
			<a href={post.href}>{post.title}</a>
		</h3>
		<p>{post.excerpt}</p>
		<div class="blog-post__meta" aria-label="文章信息">
			<time datetime={formatFullDate(post.publishedAt)}>{formatPostDate(post.publishedAt)}</time>
			<a href={buildCategoryHref(post.category)}>{post.categoryTitle}</a>
			{visibleTags.map((tag) => <span class="blog-post__tag">#{tag}</span>)}
		</div>
	</article>
</li>

<style lang="scss">
	.blog-post {
		position: relative;
		min-width: 0;
		animation: blog-post-reveal 0.38s ease both;
	}

	.blog-post article {
		min-width: 0;
	}

	.blog-post h3 {
		margin: 0;
		font-family: var(--type-card-title-font);
		font-size: clamp(1.25rem, 2.4vw, 1.55rem);
		font-weight: 650;
		line-height: 1.35;
		letter-spacing: 0;
		overflow-wrap: anywhere;
	}

	.blog-post h3 a {
		color: rgba(216, 222, 233, 0.84);
		text-decoration: none;
		transition: color 0.2s ease, text-shadow 0.2s ease;
	}

	.blog-post h3 a:hover {
		color: var(--color-text);
		text-shadow: 0 0 22px rgba(156, 199, 232, 0.12);
	}

	.blog-post p {
		display: -webkit-box;
		max-width: 700px;
		overflow: hidden;
		margin: 8px 0 0;
		color: var(--color-text-muted);
		font-size: 0.95rem;
		line-height: 1.75;
		overflow-wrap: anywhere;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
	}

	.blog-post__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		margin-top: 12px;
		color: rgba(139, 149, 167, 0.88);
		font-family: var(--type-meta-font);
		font-size: var(--type-meta-size);
		line-height: var(--type-meta-line);
	}

	.blog-post__meta > * + *::before {
		margin: 0 9px;
		color: rgba(139, 149, 167, 0.48);
		content: "·";
	}

	.blog-post__meta a {
		color: rgba(156, 199, 232, 0.76);
		transition: color 0.18s ease;
	}

	.blog-post__meta a:hover {
		color: var(--color-accent);
	}

	.blog-post__meta a:focus-visible {
		border-radius: 2px;
		outline: 1px solid rgba(156, 199, 232, 0.7);
		outline-offset: 3px;
	}

	.blog-post__tag {
		color: rgba(214, 167, 200, 0.76);
	}

	@keyframes blog-post-reveal {
		from {
			opacity: 0;
			transform: translateY(6px);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.blog-post {
			animation: none;
		}
	}
</style>
