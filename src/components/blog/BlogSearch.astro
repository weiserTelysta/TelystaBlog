---
import { BLOG_PAGE_CONFIG } from '../../config/pages/blog';
const copy = BLOG_PAGE_CONFIG.search;
---
<div class="blog-search">
	<button type="button" class="blog-search__trigger" aria-label={copy.label} title={copy.label} aria-haspopup="dialog" hidden>
		<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4.5 4.5"/></svg>
	</button>
	<dialog class="blog-search__dialog" aria-label={copy.label} data-scroll-native>
		<form role="search">
			<input id="blog-search-input" type="search" aria-label={copy.label} maxlength="160" placeholder={copy.placeholder} autocomplete="off" autofocus />
			<button type="button" class="blog-search__close" aria-label={copy.closeLabel}>×</button>
		</form>
		<div class="blog-search__matches" data-scroll-native>
			<p class="blog-search__status" role="status" aria-live="polite"></p>
			<ul class="blog-search__results"></ul>
		</div>
	</dialog>
</div>

<script>
	import { BLOG_PAGE_CONFIG } from '../../config/pages/blog';
	const copy = BLOG_PAGE_CONFIG.search;
	import { searchPosts, searchSnippet, matchRanges, type SearchPost } from '../../lib/blogSearch';
	import { startSmoothScroll, stopSmoothScroll } from '../../lib/scrollRuntime';
	const root = document.querySelector<HTMLElement>('.blog-search');
	if (root) {
		const trigger = root.querySelector<HTMLButtonElement>('.blog-search__trigger')!;
		const dialog = root.querySelector<HTMLDialogElement>('dialog')!;
		const input = root.querySelector<HTMLInputElement>('input')!;
		const status = root.querySelector<HTMLElement>('[role="status"]')!;
		const results = root.querySelector<HTMLUListElement>('ul')!;
		const matchesRegion = root.querySelector<HTMLElement>('.blog-search__matches')!;
		let posts: SearchPost[] | undefined;
		let loading: Promise<void> | undefined;
		let timer: number | undefined;
		let closing: Animation | undefined;
		let entering: Animation | undefined;
		let originalOverflow = '';
		let resultAnimation: Animation | undefined;
		let composing = false;
		const reduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		function appendHighlighted(element: HTMLElement, text: string) {
			let cursor = 0;
			for (const [start, end] of matchRanges(text, input.value)) {
				element.append(document.createTextNode(text.slice(cursor, start)));
				const mark = document.createElement('mark'); mark.textContent = text.slice(start, end);
				element.append(mark); cursor = end;
			}
			element.append(document.createTextNode(text.slice(cursor)));
		}
		function render() {
			if (composing) return;
			if (!posts) return;
			resultAnimation?.cancel();
			results.replaceChildren(); matchesRegion.scrollTop = 0;
			status.classList.remove('is-sr-only');
			if (!input.value.trim()) { status.textContent = ''; return; }
			const matches = searchPosts(posts, input.value);
			status.classList.toggle('is-sr-only', matches.length > 0);
			status.textContent = matches.length ? copy.resultCount.replaceAll('{count}', String(matches.length)) + (matches.length > 20 ? copy.limited.replaceAll('{limit}', '20') : '') : copy.empty;
			for (const post of matches.slice(0, 20)) {
				const item = document.createElement('li');
				const link = document.createElement('a'); link.href = post.href;
				const title = document.createElement('span'); appendHighlighted(title, post.title);
				const excerpt = document.createElement('p'); appendHighlighted(excerpt, searchSnippet(post, input.value));
				link.append(title, excerpt); item.append(link); results.append(item);
			}
			if (!reduced() && matches.length && dialog.open) resultAnimation = results.animate([{ opacity: 0.65 }, { opacity: 1 }], { duration: 110, easing: 'ease-out' });
		}
		async function load() {
			if (posts) { render(); return; }
			if (loading) return loading;
			status.classList.add('is-sr-only'); status.textContent = copy.loading;
			loading = (async () => {
				try {
					const response = await fetch('/blog/search-index.json', { signal: AbortSignal.timeout(15000) });
					if (!response.ok) throw new Error('Search unavailable');
					posts = await response.json(); render();
				} catch { status.classList.remove('is-sr-only'); status.textContent = copy.error; }
				finally { loading = undefined; }
			})();
			return loading;
		}
		function close() {
			if (!dialog.open || closing) return;
			const current = getComputedStyle(dialog);
			const start = { opacity: current.opacity, transform: current.transform };
			entering?.cancel(); entering = undefined;
			if (reduced()) { dialog.close(); return; }
			closing = dialog.animate([start, { opacity: 0, transform: 'translateY(4px)' }], { duration: 140, easing: 'ease-in' });
			closing.onfinish = () => { closing = undefined; dialog.close(); };
		}
		trigger.hidden = false;
		trigger.addEventListener('click', () => {
			if (dialog.open) return;
			originalOverflow = document.body.style.overflow;
			dialog.showModal(); input.focus({ preventScroll: true });
			document.body.style.overflow = 'hidden';
			document.documentElement.classList.add('has-modal-open'); stopSmoothScroll();
			if (!reduced()) entering = dialog.animate([{ opacity: 0, transform: 'translateY(6px)' }, { opacity: 1, transform: 'translateY(0)' }], { duration: 180, easing: 'ease-out' });
			void load();
		});
		dialog.addEventListener('close', () => {
			closing?.cancel(); closing = undefined;
			document.body.style.overflow = originalOverflow;
			document.documentElement.classList.remove('has-modal-open'); startSmoothScroll();
			trigger.focus({ preventScroll: true });
		});
		dialog.addEventListener('cancel', event => { event.preventDefault(); close(); });
		// Search inputs can consume Escape to clear text before the native dialog cancel event.
		dialog.addEventListener('keydown', event => {
			if (event.key === 'Escape' && !event.isComposing) { event.preventDefault(); event.stopPropagation(); close(); }
			if (event.isComposing || !['ArrowDown', 'ArrowUp'].includes(event.key)) return;
			const links = Array.from(results.querySelectorAll('a'));
			if (!links.length) return;
			const current = links.indexOf(document.activeElement as HTMLAnchorElement);
			if (document.activeElement !== input && current < 0) return;
			event.preventDefault();
			if (event.key === 'ArrowUp' && current === 0) input.focus({ preventScroll: true });
			else links[event.key === 'ArrowDown' ? Math.min(current + 1, links.length - 1) : current < 0 ? links.length - 1 : current - 1].focus({ preventScroll: true });
			(document.activeElement as HTMLElement).scrollIntoView({ block: 'nearest' });
		});
		window.addEventListener('pagehide', () => { if (dialog.open) dialog.close(); });
		root.querySelector('.blog-search__close')!.addEventListener('click', close);
		dialog.addEventListener('click', event => {
			if (event.target !== dialog) return;
			const box = dialog.getBoundingClientRect();
			if (event.clientX < box.left || event.clientX > box.right || event.clientY < box.top || event.clientY > box.bottom) close();
		});
		input.addEventListener('compositionstart', () => { composing = true; clearTimeout(timer); });
		input.addEventListener('compositionend', () => { composing = false; clearTimeout(timer); timer = window.setTimeout(render, 100); });
		input.addEventListener('input', () => { clearTimeout(timer); if (!composing) timer = window.setTimeout(render, 100); });
		root.querySelector('form')!.addEventListener('submit', event => { event.preventDefault(); clearTimeout(timer); render(); results.querySelector('a')?.focus(); });
	}
</script>

<style lang="scss">
	.blog-search__trigger, .blog-search__close { display: grid; place-items: center; width: 44px; height: 44px; padding: 0; border: 0; background: transparent; color: var(--color-text-muted); cursor: pointer; transition: color var(--motion-fast) ease, transform var(--motion-fast) ease; }
	.blog-search__trigger[hidden] { display: none; }
	button:hover { color: var(--color-accent); }
	button:active { transform: scale(0.96); }
	button:focus-visible, .blog-search__results :global(a:focus-visible) { outline: 1px solid var(--color-accent); outline-offset: -1px; }
	.blog-search__dialog { width: min(640px, calc(100% - 40px)); height: min(68dvh, 620px); max-height: calc(100dvh - 100px); margin: clamp(64px, 14dvh, 150px) auto auto; padding: 2px; border: 0; border-radius: 0; background: transparent; color: var(--color-text); font-family: var(--font-body); overflow: hidden; }
	.blog-search__dialog[open] { display: grid; grid-template-rows: auto minmax(0, 1fr); gap: 24px; }
	.blog-search__dialog::backdrop { background: rgba(7, 10, 16, 0.98); }
	form { display: flex; align-items: center; gap: 12px; }
	.blog-search__close { flex: 0 0 44px; font-size: 1.5rem; }
	input { flex: 1; width: 100%; min-width: 0; padding: 12px 0; border: 0; border-bottom: 1px solid var(--color-text-muted); border-radius: 0; font: inherit; font-size: 1.1rem; background: transparent; color: var(--color-text); transition: border-color var(--motion-fast) ease; }
	input:focus-visible { outline: none; border-bottom-color: var(--color-accent); box-shadow: 0 1px var(--color-accent); }
	input::placeholder { color: var(--color-text-muted); }
	input::-webkit-search-cancel-button { display: none; }
	.blog-search__matches { min-height: 0; overflow-y: auto; overscroll-behavior: contain; scrollbar-width: none; }
	.blog-search__matches::-webkit-scrollbar { display: none; }
	.blog-search__status { margin: 0; font-size: 0.8rem; line-height: 1.8; color: var(--color-text-muted); }
	.is-sr-only { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
	.blog-search__results { margin: 0; padding: 0; list-style: none; }
	.blog-search__results :global(a) { display: block; padding: 14px 2px; text-decoration: none; overflow-wrap: anywhere; transition: color var(--motion-fast) ease; }
	.blog-search__results :global(a:hover) { color: var(--color-accent); }
	.blog-search__results :global(span) { font-size: 0.94rem; font-weight: 550; }
	.blog-search__results :global(p) { margin: 6px 0 0; font-size: 0.8rem; line-height: 1.8; color: var(--color-text-muted); }
	.blog-search__results :global(mark) { color: var(--color-accent); background: transparent; font-weight: inherit; text-decoration: underline; text-decoration-color: rgba(156, 199, 232, 0.45); text-underline-offset: 3px; }
	@media (prefers-reduced-motion: reduce) { button, input, .blog-search__results :global(a) { transition: none; } button:active { transform: none; } }
</style>
