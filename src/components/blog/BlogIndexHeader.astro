---
import { BLOG_PAGE_CONFIG } from '../../config/pages/blog';
import BlogSearch from './BlogSearch.astro';
const { indexHeader } = BLOG_PAGE_CONFIG;
---

<header class="blog-index-header" aria-labelledby="blog-index-title">
	<h1 id="blog-index-title">{indexHeader.title}</h1>
	<BlogSearch />
</header>

<style lang="scss">
	.blog-index-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		max-width: 100%;
	}

	h1 {
		min-width: 0;
		margin: 0;
		color: rgba(216, 222, 233, 0.86);
		font-family: var(--type-index-title-font);
		font-size: clamp(1.9rem, 4vw, 2.4rem);
		font-weight: var(--type-index-title-weight);
		line-height: 1.16;
		letter-spacing: 0;
	}

	@media (max-width: 640px) {
		h1 {
			font-size: clamp(1.8rem, 8.5vw, 2.1rem);
		}
	}
</style>
