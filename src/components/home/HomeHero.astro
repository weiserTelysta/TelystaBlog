---
import HomeIntro from './HomeIntro';
---

<section class="home" aria-label="Telysta home introduction" data-home-hero>
	<div class="hero">
		<HomeIntro client:only="react">
			<div class="home-intro home-intro--fallback" slot="fallback" aria-hidden="true">
				<div class="home-identity home-identity--placeholder">
					<span class="home-intro__placeholder-name"></span>
				</div>
				<p class="time-greeting time-greeting--placeholder">
					<span class="home-intro__placeholder-line"></span>
					<span class="home-intro__placeholder-line home-intro__placeholder-line--short"></span>
				</p>
			</div>
		</HomeIntro>
	</div>
</section>

<style lang="scss">
	.home {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: calc(100svh - var(--site-header-block-size));
		padding: clamp(136px, 18vh, 188px) clamp(24px, 8vw, 112px) 124px;
	}

	.hero {
		display: flex;
		width: min(820px, 100%);
		align-items: center;
		flex-direction: column;
		text-align: center;
	}

	:global(.home-intro) {
		--home-intro-accent: rgba(156, 199, 232, 0.76);
		--home-intro-accent-soft: rgba(156, 199, 232, 0.16);
		display: flex;
		width: 100%;
		align-items: center;
		flex-direction: column;
	}

	:global(.home-identity) {
		position: relative;
		display: flex;
		align-items: center;
		flex-direction: column;
		opacity: 0.96;
		transition:
			opacity 260ms cubic-bezier(0.22, 0.72, 0.24, 1),
			transform 300ms cubic-bezier(0.22, 0.72, 0.24, 1);
	}

	:global(.home-identity.is-ready) {
		opacity: 1;
	}

	:global(.home-identity__avatar-shell) {
		position: relative;
		display: block;
		width: clamp(96px, 12vw, 120px);
		height: clamp(96px, 12vw, 120px);
		border-radius: 50%;
	}

	:global(.home-identity__avatar-shell::before) {
		content: "";
		position: absolute;
		border-radius: 50%;
		pointer-events: none;
	}

	:global(.home-identity__avatar-shell::before) {
		inset: -16px;
		z-index: 0;
		background:
			radial-gradient(circle, color-mix(in srgb, var(--home-intro-accent-soft) 74%, transparent), transparent 56%),
			radial-gradient(circle, color-mix(in srgb, var(--home-intro-accent) 6%, transparent), transparent 74%);
		opacity: 0;
		filter: blur(14px);
		transform: scale(0.94);
		transition:
			opacity 620ms cubic-bezier(0.22, 0.72, 0.24, 1),
			transform 760ms cubic-bezier(0.22, 0.72, 0.24, 1);
	}

	:global(.home-intro--revealed .home-identity__avatar-shell::before),
	:global(.home-intro--speaking .home-identity__avatar-shell::before),
	:global(.home-intro--settled .home-identity__avatar-shell::before) {
		opacity: 0.48;
		transform: scale(1);
	}

	:global(.home-intro--settled .home-identity__avatar-shell::before) {
		animation: avatar-glow-breathe 6.8s ease-in-out infinite;
		opacity: 0.26;
	}

	:global(.home-identity__avatar) {
		position: relative;
		z-index: 1;
		display: block;
		width: 100%;
		height: 100%;
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.025);
		box-shadow:
			0 16px 42px rgba(0, 0, 0, 0.28),
			0 0 0 5px rgba(255, 255, 255, 0.018),
			0 0 32px rgba(156, 199, 232, 0.08);
		opacity: 0;
		object-fit: cover;
		transform: scale(0.975);
		filter: blur(4px);
		transition:
			opacity 520ms cubic-bezier(0.22, 0.72, 0.24, 1),
			transform 640ms cubic-bezier(0.22, 0.72, 0.24, 1),
			filter 620ms cubic-bezier(0.22, 0.72, 0.24, 1),
			box-shadow 520ms ease;
	}

	:global(.home-intro--revealed .home-identity__avatar),
	:global(.home-intro--speaking .home-identity__avatar),
	:global(.home-intro--settled .home-identity__avatar) {
		box-shadow:
			0 16px 42px rgba(0, 0, 0, 0.28),
			0 0 0 5px rgba(255, 255, 255, 0.018),
			0 0 24px color-mix(in srgb, var(--home-intro-accent-soft) 72%, transparent);
		opacity: 1;
		transform: scale(1);
		filter: blur(0);
	}

	:global(.home-identity__name) {
		margin: 34px 0 0;
		color: rgba(237, 243, 251, 0.9);
		font-family: var(--type-hero-title-font);
		font-size: var(--type-hero-title-size);
		font-weight: var(--type-hero-title-weight);
		line-height: var(--type-hero-title-line);
		letter-spacing: 0.018em;
		text-shadow:
			0 2px 22px rgba(0, 0, 0, 0.46),
			0 0 26px rgba(156, 199, 232, 0.055);
		opacity: 0;
		transform: translateY(5px);
		transition:
			opacity 420ms cubic-bezier(0.22, 0.72, 0.24, 1) 120ms,
			transform 500ms cubic-bezier(0.22, 0.72, 0.24, 1) 120ms,
			text-shadow 420ms ease;
	}

	:global(.home-intro--revealed .home-identity__name),
	:global(.home-intro--speaking .home-identity__name),
	:global(.home-intro--settled .home-identity__name) {
		opacity: 1;
		transform: translateY(0);
		text-shadow:
			0 2px 22px rgba(0, 0, 0, 0.46),
			0 0 24px var(--home-intro-accent-soft);
	}

	:global(.time-greeting) {
		min-height: 4.2em;
		max-width: min(680px, 100%);
		margin: 30px 0 0;
		color: rgba(185, 198, 216, 0.56);
		font-size: clamp(0.98rem, 1.75vw, 1.1rem);
		line-height: 1.9;
		white-space: pre-wrap;
		text-wrap: balance;
		text-shadow: 0 2px 16px rgba(0, 0, 0, 0.42);
	}

	:global(.home-intro--speaking .time-greeting--fade) {
		animation: greeting-fade-in 760ms cubic-bezier(0.2, 0.72, 0.24, 1) both;
	}

	:global(.home-intro--summoning .time-greeting),
	:global(.home-intro--revealed .time-greeting) {
		opacity: 0.42;
	}

	:global(.time-greeting__cursor) {
		display: inline-block;
		width: 0.58em;
		height: 1.1em;
		margin-left: 0.18em;
		border-right: 2px solid rgba(156, 199, 232, 0.56);
		vertical-align: -0.16em;
		animation: cursor-blink 1s steps(2, start) infinite;
	}

	:global(.home-intro__placeholder-name) {
		width: min(160px, 42vw);
		height: 1.1rem;
		margin-top: 38px;
		border-radius: 999px;
		background: linear-gradient(
			90deg,
			transparent,
			rgba(156, 199, 232, 0.14),
			transparent
		);
	}

	:global(.home-intro__placeholder-line) {
		display: block;
		width: min(420px, 72vw);
		height: 1px;
		margin: 0 auto;
		background: linear-gradient(
			90deg,
			transparent,
			rgba(156, 199, 232, 0.16),
			transparent
		);
	}

	:global(.home-intro__placeholder-line + .home-intro__placeholder-line) {
		margin-top: 1.1rem;
	}

	:global(.home-intro__placeholder-line--short) {
		width: min(280px, 48vw);
		opacity: 0.72;
	}

	:global(.time-greeting--placeholder) {
		opacity: 0.58;
	}

	@media (max-width: 640px) {
		.home {
			padding: 92px 20px 84px;
		}

		:global(.time-greeting) {
			min-height: 6.8em;
		}
	}

	@keyframes greeting-fade-in {
		from {
			opacity: 0;
			transform: translateY(6px);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes avatar-glow-breathe {
		0%,
		100% {
			opacity: 0.22;
			transform: scale(0.985);
		}

		50% {
			opacity: 0.32;
			transform: scale(1.015);
		}
	}

	@keyframes cursor-blink {
		0%,
		45% {
			opacity: 1;
		}

		46%,
		100% {
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		:global(.home-identity__avatar-shell::before),
		:global(.home-identity__avatar),
		:global(.home-identity__name),
		:global(.time-greeting__cursor) {
			animation: none;
			transition: none;
		}

		:global(.home-identity__avatar),
		:global(.home-identity__name) {
			opacity: 1;
			transform: none;
			filter: none;
		}

		:global(.home-identity__avatar-shell::before) {
			opacity: 0.26;
			transform: none;
		}
	}
</style>
