---
import type { HomeSectionConfig } from '../../config/pages/home';
import HomeFlowerTrail from './HomeFlowerTrail.astro';

type Props = {
	section: HomeSectionConfig;
	index: number;
};

const { section, index } = Astro.props;
const hasItems = section.items && section.items.length > 0;
---

<article
	class={`home-section home-section--${section.type}`}
	data-home-reveal
	style={`--reveal-order: ${index}`}
>
	{section.type === 'profile' && <div class="home-section__rule home-section__reveal-part" aria-hidden="true"></div>}
	<div class="home-section__body">
		{
			section.eyebrow && (
				<p class="home-section__eyebrow home-section__reveal-part" style="--part-order: 1">
					{section.eyebrow}
				</p>
			)
		}
		<h2 class="home-section__title home-section__reveal-part" style="--part-order: 2">
			{section.title}
		</h2>
		<div class="home-section__description home-section__reveal-part" style="--part-order: 3">
			{section.description.map((paragraph) => <p>{paragraph}</p>)}
		</div>

		{
			hasItems && (
				<ul
					class="home-section__links home-section__reveal-part"
					aria-label={`${section.title} links`}
					style="--part-order: 4"
				>
					{section.items?.map((item, itemIndex) => {
						const Tag = item.href ? 'a' : 'span';
						return (
							<li class="home-section__link-item">
								<Tag
									class:list={['home-section__link', item.href ? 'text-link' : 'home-section__link--disabled']}
									href={item.href}
									target={item.href && item.external ? '_blank' : undefined}
									rel={item.href && item.external ? 'noreferrer' : undefined}
								>
									<span class="home-section__link-copy">
										<span class="home-section__link-text">
											<span class="home-section__link-label">{item.label}</span>
											{item.kind && <span class="home-section__link-kind" lang="en">{item.kind}</span>}
										</span>
										{item.description && <span class="home-section__link-description">{item.description}</span>}
									</span>
									{item.flower && (
									<HomeFlowerTrail id={`home-flower-${index}-${itemIndex}`} flower={item.flower} />
									)}
								</Tag>
							</li>
						);
					})}
				</ul>
			)
		}
	</div>
</article>
