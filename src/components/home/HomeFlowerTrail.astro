		sweep: [
			['blossom', 54, 65, 8, 14, .34], ['petal', 61, 84, 6, 34, .32],
			['blossom', 69, 41, 10, 8, .47], ['blossom', 74, 22, 7, 32, .39],
			['blossom', 76, 58, 11, 48, .47], ['blossom', 83, 34, 8, 12, .43],
			['petal', 87, 72, 7, -32, .38], ['petal', 94, 40, 6, -9, .40],
		],
	},
};

type Props = { id: string; flower: Flower };
const { id, flower } = Astro.props;
const trail = trails[flower];
const petalWash = `${id}-petal-wash`;
const foldWash = `${id}-fold-wash`;
const blossomWash = `${id}-blossom-wash`;
const flowers = { cherry, peach, camellia, hydrangea };
// The source illustrations are local SVGs. Scope their IDs separately from the trail.
const bloom = flowers[flower].replace(/\b(id="|href="#|url\(#)([\w-]+)/g, `$1${id}-bloom-$2`);
---

<svg class="home-section__petal-trail" data-flower={flower} aria-hidden="true" focusable="false" fill="currentColor" fill-rule="evenodd">
	<defs>
		<linearGradient id={petalWash} x1="15%" y1="17%" x2="75%" y2="89%">
			<stop stop-color="currentColor" />
			<stop offset=".56" stop-color="currentColor" stop-opacity=".88" />
			<stop offset="1" stop-color="currentColor" stop-opacity=".57" />
		</linearGradient>
		<linearGradient id={foldWash} x1="27%" y1="4%" x2="68%" y2="78%">
			<stop stop-color={trail.flowerCenter} stop-opacity=".68" />
			<stop offset="1" stop-color={trail.flowerCenter} stop-opacity=".06" />
		</linearGradient>
		<radialGradient id={blossomWash} cx="42%" cy="40%" r="60%">
			<stop stop-color="currentColor" stop-opacity=".68" />
			<stop offset=".57" stop-color="currentColor" />
			<stop offset="1" stop-color="currentColor" stop-opacity=".83" />
		</radialGradient>
		<g id={`${id}-petal`}>
			<path d={trail.petal} fill={`url(#${petalWash})`} />
			<path d={trail.petalFold} fill={`url(#${foldWash})`} />
			<path d={trail.petalVein} fill="none" stroke={trail.flowerCenter} stroke-opacity=".53" stroke-width=".36" stroke-linecap="round" />
		</g>
		<g id={`${id}-blossom`}>
			<path d={trail.blossom} fill={`url(#${blossomWash})`} />
			<path d={trail.blossomVeins} fill="none" stroke={trail.flowerCenter} stroke-opacity=".55" stroke-width=".41" stroke-linecap="round" />
			<path d={trail.stamens} fill="none" stroke={trail.flowerCenter} stroke-opacity=".84" stroke-width=".65" stroke-linecap="round" />
			<circle cx={flower === 'hydrangea' ? .7 : 0} cy={flower === 'hydrangea' ? .32 : 0} r=".62" fill={trail.flowerCenter} />
		</g>
	</defs>
	{(['tail', 'sweep'] as const).map(layer => (
		<g class={`home-section__petal-${layer}`}>
			{trail[layer].map(([shape, x, y, size, rotation, opacity], index, fragments) => (
				<svg x={`${x}%`} y={`${y}%`} width={size} height={size} viewBox="-5 -5 10 10" overflow="visible"
					style={layer === 'sweep' ? `--petal-delay:${120 + (fragments.length - 1 - index) * 22}ms` : undefined}>
					<g data-fragment={shape}>
						<use href={`#${id}-${shape}`} transform={`rotate(${rotation})`} opacity={opacity} />
					</g>
				</svg>
			))}
		</g>
	))}
</svg>
<span class="home-section__flower" data-flower={flower} aria-hidden="true" set:html={bloom} />
