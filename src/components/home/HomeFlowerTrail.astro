type Flower = NonNullable<HomeSectionItem['flower']>;
type Fragment = [shape: 'petal' | 'blossom', xPercent: number, yPercent: number, size: number, rotation: number, opacity: number];
type Trail = {
	petal: string;
	petalFold: string;
	petalVein: string;
	blossom: string;
	blossomVeins: string;
	stamens: string;
	flowerCenter: string;
	tail: Fragment[];
	sweep: Fragment[];
