---
import { ARTICLE_PAGE_CONFIG } from '../../config/pages/article';
import ArticleToc from './ArticleToc.astro';

type ArticleHeading = {
	depth: number;
	slug: string;
	text: string;
};

type Props = {
	headings: ArticleHeading[];
};

const { headings } = Astro.props;
const { toc } = ARTICLE_PAGE_CONFIG;
const hasToc = headings.length > 0;
---

<aside class="article-aside" data-article-aside>
	{
		hasToc && (
			<div class="article-aside__toc">
				<p class="article-aside__toc-title">{toc.title}</p>
				<div class="article-aside__toc-list" data-scroll-native data-article-toc-list>
					<ArticleToc headings={headings} ariaLabel={toc.ariaLabel} />
				</div>
			</div>
		)
	}
</aside>

<style lang="scss">
	.article-aside {
		position: sticky;
		top: var(--site-header-clearance);
		display: grid;
		min-width: 0;
		max-height: calc(100vh - var(--site-header-clearance) - 24px);
		min-height: 0;
	}

	.article-aside__toc {
		position: relative;
		display: grid;
		grid-template-rows: auto minmax(0, 1fr);
		gap: 16px;
		min-width: 0;
		max-height: inherit;
		min-height: 0;
		padding-left: 22px;
	}

	.article-aside__toc::before {
		position: absolute;
		top: 2px;
		bottom: 2px;
		left: 0;
		width: 1px;
		content: '';
		background: linear-gradient(
			180deg,
			transparent,
			rgba(156, 199, 232, 0.16) 18%,
			rgba(156, 199, 232, 0.08) 74%,
			transparent
		);
	}

	.article-aside__toc-title {
		margin: 0;
		color: rgba(156, 199, 232, 0.58);
		font-family: var(--font-display);
		font-size: 0.72rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.article-aside__toc-list {
		display: block;
		min-height: 0;
		max-height: none;
		min-width: 0;
		overflow-y: auto;
		padding: 2px 10px 72px 0;
		overscroll-behavior: contain;
		scroll-padding-block: 20px 72px;
		scrollbar-width: none;
	}

	.article-aside__toc-list::-webkit-scrollbar {
		display: none;
	}

	.article-aside__toc-list[data-toc-scrollable='false'] {
		padding-bottom: 2px;
	}

	@media (max-width: 960px) {
		.article-aside {
			position: static;
			max-height: none;
			padding: 18px 0 0;
			border-top: 1px solid rgba(255, 255, 255, 0.055);
		}

		.article-aside__toc {
			position: static;
			padding-left: 0;
		}

		.article-aside__toc-list {
			max-height: none;
			overflow: visible;
			padding: 0;
		}

		.article-aside__toc::before {
			display: none;
		}
	}
</style>

<script>
	import { bindArticleTocRuntime, initArticleTocRuntime } from '../../lib/articleTocRuntime';

	initArticleTocRuntime();
	bindArticleTocRuntime();
</script>
