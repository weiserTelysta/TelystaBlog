---
import type { BlogSeries } from '../../config/content/blogSeries';
import { buildSeriesHref } from '../../lib/blogSeriesUtils';

type Props = {
	series?: BlogSeries;
};

const { series } = Astro.props;
---

{
	series && (
		<nav class="article-series" aria-label="所属系列">
			<a href={buildSeriesHref(series.id)} aria-label={`所属系列：${series.title}`}>
				{series.title}
			</a>
		</nav>
	)
}

<style lang="scss">
	.article-series {
		width: min(var(--article-reading-width), 100%);
		margin-top: clamp(54px, 9vw, 88px);
		margin-inline: auto;
		padding-top: 22px;
		border-top: 1px solid rgba(255, 255, 255, 0.055);
	}

	.article-series a {
		color: rgba(156, 199, 232, 0.74);
		font-size: 0.94rem;
		line-height: 1.6;
		text-decoration: underline;
		text-decoration-color: transparent;
		text-underline-offset: 0.24em;
		overflow-wrap: anywhere;
		transition: color 0.16s ease, text-decoration-color 0.16s ease;
	}

	.article-series a:hover {
		color: rgba(216, 222, 233, 0.9);
		text-decoration-color: rgba(156, 199, 232, 0.42);
	}

	.article-series a:focus-visible {
		border-radius: 2px;
		outline: 1px solid rgba(156, 199, 232, 0.78);
		outline-offset: 4px;
	}
</style>
