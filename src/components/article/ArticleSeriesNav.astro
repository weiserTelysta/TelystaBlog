---
import type { BlogSeries } from '../../config/content/blogSeries';
import { ARTICLE_PAGE_CONFIG } from '../../config/pages/article';
import type { SeriesNavigation } from '../../lib/blogPosts';
import { buildSeriesHref } from '../../lib/blogSeriesUtils';

type Props = {
	series?: BlogSeries;
	postCount?: number;
	navigation?: SeriesNavigation;
};

const { series, postCount, navigation } = Astro.props;
const copy = ARTICLE_PAGE_CONFIG.series.navigation;
const countLabel = typeof postCount === 'number'
	? String(postCount).padStart(2, '0')
	: undefined;
const controls = [
	{ key: 'previous', label: copy.previousLabel, target: series ? navigation?.previous : undefined, rel: 'prev' },
	{ key: 'contents', label: copy.contentsLabel, target: series ? { href: buildSeriesHref(series.id), title: series.title } : undefined },
	{ key: 'next', label: copy.nextLabel, target: series ? navigation?.next : undefined, rel: 'next' },
];
---

<nav class="article-series" aria-label={copy.ariaLabel}>
	{
		series && (
			<a
				class="article-series__link"
				href={buildSeriesHref(series.id)}
				aria-label={`所属系列：${series.title}`}
			>
				<strong>{series.title}</strong>
				{countLabel && <span class="article-series__count" aria-label={`共 ${postCount} 篇`}>{countLabel}</span>}
			</a>
		)
	}
	<ol class="article-series__chapters">
		{controls.map(({ key, label, target, rel }) => {
			const Tag = target ? 'a' : 'span';
			return (
				<li>
					<Tag
						class:list={['article-series__chapter', `article-series__chapter--${key}`]}
						href={target?.href}
						rel={target ? rel : undefined}
						role={target ? undefined : 'link'}
						aria-disabled={target ? undefined : 'true'}
						aria-label={`${label}：${target?.title ?? copy.unavailableLabel}`}
					>
						{key === 'previous' && <svg class="article-series__arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M12.5 8h-9m4-4-4 4 4 4" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" /></svg>}
						<span>{label}</span>
						{key === 'next' && <svg class="article-series__arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3.5 8h9m-4-4 4 4-4 4" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" /></svg>}
					</Tag>
				</li>
			);
		})}
	</ol>
</nav>

<style lang="scss">
	.article-series {
		margin-top: clamp(54px, 9vw, 88px);
	}

	.article-series__link {
		position: relative;
		display: flex;
		gap: clamp(20px, 5vw, 48px);
		min-height: 72px;
		align-items: center;
		justify-content: space-between;
		padding: 14px 0;
	}

	.article-series__link > strong {
		min-width: 0;
		color: rgba(237, 243, 251, 0.88);
		font-family: var(--type-section-title-font);
		font-size: clamp(1.12rem, 1.9vw, 1.3rem);
		font-weight: var(--type-section-title-weight);
		line-height: 1.34;
		overflow-wrap: anywhere;
		transition: color var(--motion-fast) ease;
	}

	.article-series__count {
		flex: 0 0 auto;
		color: rgba(156, 199, 232, 0.56);
		font-family: var(--type-display-label-font);
		font-size: 0.82rem;
		font-weight: var(--type-display-label-weight);
		letter-spacing: var(--type-display-label-tracking);
		transition: color var(--motion-fast) ease;
	}

	.article-series__link:hover > strong,
	.article-series__link:focus-visible > strong {
		color: var(--color-text-strong);
	}

	.article-series__link:hover .article-series__count,
	.article-series__link:focus-visible .article-series__count {
		color: rgba(156, 199, 232, 0.76);
	}

	.article-series__link:active {
		opacity: 0.82;
	}

	.article-series__link:focus-visible {
		border-radius: 2px;
		outline: 1px solid rgba(156, 199, 232, 0.78);
		outline-offset: 3px;
	}

	.article-series__chapters {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		margin: 8px 0 0;
		padding: 0;
		list-style: none;
	}

	.article-series__chapters > li {
		min-width: 0;
	}

	.article-series__chapter {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		min-height: 48px;
		padding: 10px 4px;
		color: var(--color-text-muted);
		font-family: var(--type-meta-font);
		font-size: 0.9rem;
		font-weight: 400;
		line-height: 1.5;
		text-decoration: none;
		transition: color var(--motion-fast) ease, opacity var(--motion-fast) ease;
	}

	.article-series__chapter[aria-disabled="true"] {
		color: color-mix(in srgb, var(--color-text-muted) 50%, var(--color-background));
		cursor: default;
	}

	.article-series__chapter[href]:hover,
	.article-series__chapter[href]:focus-visible {
		color: var(--color-accent);
	}

	.article-series__chapter[href]:focus-visible {
		outline: 1px solid var(--color-accent);
		outline-offset: 2px;
		border-radius: 2px;
	}

	.article-series__chapter[href]:active {
		opacity: 0.72;
		transition-duration: 70ms;
	}

	.article-series__arrow {
		flex: 0 0 auto;
		transition: transform var(--motion-fast) var(--motion-ease-out);
	}

	.article-series__chapter--previous[href]:is(:hover, :focus-visible) .article-series__arrow {
		transform: translateX(-2px);
	}

	.article-series__chapter--next[href]:is(:hover, :focus-visible) .article-series__arrow {
		transform: translateX(2px);
	}

	@media (max-width: 640px) {
		.article-series__link {
			min-height: 66px;
			padding-block: 12px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.article-series__link > strong,
		.article-series__count,
		.article-series__chapter,
		.article-series__arrow {
			transition: none !important;
		}

		.article-series__arrow {
			transform: none !important;
		}
	}
</style>
