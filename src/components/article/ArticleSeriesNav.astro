---
import type { BlogSeries } from '../../config/content/blogSeries';
import { buildSeriesHref } from '../../lib/blogSeriesUtils';

type Props = {
	series?: BlogSeries;
	postCount?: number;
};

const { series, postCount } = Astro.props;
const countLabel = typeof postCount === 'number'
	? String(postCount).padStart(2, '0')
	: undefined;
---

{
	series && (
		<nav class="article-series" aria-label="所属系列">
			<a
				class="article-series__link"
				href={buildSeriesHref(series.id)}
				aria-label={`所属系列：${series.title}`}
			>
				<strong>{series.title}</strong>
				{countLabel && <span class="article-series__count" aria-label={`共 ${postCount} 篇`}>{countLabel}</span>}
			</a>
		</nav>
	)
}

<style lang="scss">
	.article-series {
		margin-top: clamp(54px, 9vw, 88px);
	}

	.article-series__link {
		position: relative;
		display: flex;
		gap: clamp(20px, 5vw, 48px);
		min-height: 72px;
		align-items: center;
		justify-content: space-between;
		padding: 14px 0;
	}

	.article-series__link > strong {
		min-width: 0;
		color: rgba(237, 243, 251, 0.88);
		font-family: var(--type-section-title-font);
		font-size: clamp(1.12rem, 1.9vw, 1.3rem);
		font-weight: var(--type-section-title-weight);
		line-height: 1.34;
		overflow-wrap: anywhere;
		transition: color var(--motion-fast) ease;
	}

	.article-series__count {
		flex: 0 0 auto;
		color: rgba(156, 199, 232, 0.56);
		font-family: var(--type-display-label-font);
		font-size: 0.82rem;
		font-weight: var(--type-display-label-weight);
		letter-spacing: var(--type-display-label-tracking);
		transition: color var(--motion-fast) ease;
	}

	.article-series__link:hover > strong,
	.article-series__link:focus-visible > strong {
		color: var(--color-text-strong);
	}

	.article-series__link:hover .article-series__count,
	.article-series__link:focus-visible .article-series__count {
		color: rgba(156, 199, 232, 0.76);
	}

	.article-series__link:active {
		opacity: 0.82;
	}

	.article-series__link:focus-visible {
		border-radius: 2px;
		outline: 1px solid rgba(156, 199, 232, 0.78);
		outline-offset: 3px;
	}

	@media (max-width: 640px) {
		.article-series__link {
			min-height: 66px;
			padding-block: 12px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.article-series__link > strong,
		.article-series__count {
			transition: none;
		}
	}
</style>
