---
import { ARTICLE_PAGE_CONFIG } from '../../config/pages/article';
import type { PostListItem } from '../../lib/blogPosts';
import { formatArticleDate, formatFullDate, formatPostDate } from '../../lib/blogPosts';

type Props = {
	post: PostListItem;
};

const { post } = Astro.props;
const cover = post.cover?.startsWith('/images/posts/') ? post.cover : undefined;
const { header } = ARTICLE_PAGE_CONFIG;
---

<header class="article-header">
	{
		cover && (
			<figure class="article-header__cover" aria-label={header.coverAriaLabel}>
				<img src={cover} alt="" loading="eager" decoding="async" />
			</figure>
		)
	}

	<h1>{post.title}</h1>

	<div class="article-header__dates" aria-label={header.metaAriaLabel}>
		<span>
			{header.publishedLabel}{' '}
			<time
				datetime={formatFullDate(post.publishedAt)}
				aria-label={formatPostDate(post.publishedAt)}
			>{formatArticleDate(post.publishedAt)}</time>
		</span>
		<span>
			{header.updatedLabel}{' '}
			<time
				datetime={formatFullDate(post.updatedAt)}
				aria-label={formatPostDate(post.updatedAt)}
			>{formatArticleDate(post.updatedAt)}</time>
		</span>
	</div>
</header>

<style lang="scss">
	.article-header {
		display: grid;
		gap: clamp(14px, 2vw, 18px);
		width: min(var(--article-reading-width), 100%);
		margin-inline: auto;
		padding: clamp(46px, 5vw, 72px) 0 clamp(36px, 5vw, 52px);
	}

	.article-header__cover {
		position: relative;
		width: 100%;
		margin: 0;
		overflow: hidden;
		border-radius: 8px;
		aspect-ratio: 16 / 6;
		background: rgba(12, 17, 26, 0.5);
	}

	.article-header__cover::after {
		content: "";
		position: absolute;
		inset: 0;
		background:
			linear-gradient(180deg, rgba(7, 10, 16, 0.08), rgba(7, 10, 16, 0.62)),
			linear-gradient(90deg, rgba(7, 10, 16, 0.34), transparent 42%);
		pointer-events: none;
	}

	.article-header__cover img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: saturate(0.76) brightness(0.62);
	}

	.article-header h1 {
		margin: 0;
		color: rgba(216, 222, 233, 0.9);
		font-family: var(--type-article-title-font);
		font-size: clamp(2rem, 3vw, 2.75rem);
		font-weight: 600;
		line-height: 1.2;
		letter-spacing: 0;
		overflow-wrap: anywhere;
	}

	.article-header__dates {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		min-width: 0;
		color: rgba(190, 199, 214, 0.66);
		font-family: var(--type-meta-font);
		font-size: 0.78rem;
		line-height: 1.6;
	}

	.article-header__dates > * + *::before {
		margin: 0 10px;
		color: rgba(139, 149, 167, 0.5);
		content: "·";
	}

	@media (max-width: 760px) {
		.article-header__cover {
			aspect-ratio: 16 / 8;
		}
	}
</style>
