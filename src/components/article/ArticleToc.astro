---
import { ARTICLE_PAGE_CONFIG } from '../../config/pages/article';
import { buildArticleTocTree, type ArticleHeading } from '../../lib/articleTocOutline';
import ArticleTocBranch from './ArticleTocBranch.astro';

type Props = {
	headings: ArticleHeading[];
	ariaLabel?: string;
};

const {
	headings,
	ariaLabel = ARTICLE_PAGE_CONFIG.toc.ariaLabel,
} = Astro.props;
const tree = buildArticleTocTree(headings);
---

<nav class="article-toc" aria-label={ariaLabel}>
	<ArticleTocBranch nodes={tree} />
</nav>

<style lang="scss">
	.article-toc {
		display: grid;
		min-width: 0;
	}

</style>
