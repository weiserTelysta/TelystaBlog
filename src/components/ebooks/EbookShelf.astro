---
import Layout from '../../layouts/Layout.astro';
import EbookCard from './EbookCard.astro';
import EbookPagination from './EbookPagination.astro';
import { EBOOK_PAGE_CONFIG as copy } from '../../config/pages/ebooks';
import { LIBRARY_CLASSES } from '../../config/library';
import { getPublishedEbookEntries, toEbook } from '../../lib/ebooks/ebooks';
import { booksInCategory, ebookShelfHref, paginateShelf, shelfBooklists, shelfCategories } from '../../lib/ebooks/shelf';
import '../../styles/ebooks.scss';
type Props = { page?: number; category?: string; booklist?: string };
const { page = 1, category, booklist } = Astro.props;
const all = (await getPublishedEbookEntries()).map(entry => toEbook(entry.data));
const categories = shelfCategories(all);
const books = booksInCategory(all, category, booklist);
const booklists = category && !booklist ? shelfBooklists(all, category) : [];
const { items, pageCount, total } = paginateShelf(books, page);
const label = booklist ? `${booklist} · ${books[0]?.clcName || booklist}` : category ? LIBRARY_CLASSES[category] : '全部藏书';
const title = booklist || category ? `${label} · ${copy.meta.title}` : copy.meta.title;
---
<Layout title={page === 1 ? title : `${title} · ${page}`} description={copy.meta.description} starfieldVariant="subtle">
	<main class="ebook-page ebook-shelf" data-ebook-shelf data-category={category || ''} data-booklist={booklist || ''} data-page={page}>
		<h1 class="ebook-sr-only">{copy.hero.title}</h1>
		<div class="ebook-tools">
			<form class="ebook-search" role="search" aria-label="搜索藏书" data-shelf-search hidden>
				<input type="search" name="q" aria-label="搜索书名或作者" placeholder="搜索书名、作者" autocomplete="off" />
				<details class="ebook-format-picker" data-format-picker>
					<summary aria-label="筛选文件格式"><span data-format-label>全部格式</span><svg viewBox="0 0 12 12" aria-hidden="true"><path d="m2 4 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.2" /></svg></summary>
					<div class="ebook-format-menu" role="group" aria-label="文件格式选项">{['', 'PDF', 'EPUB', 'MOBI', 'AZW3'].map(format => <label><input type="radio" name="format" value={format} checked={format === ''} /><span>{format || '全部格式'}</span></label>)}</div>
				</details>
				<button type="button" data-search-clear hidden>清除</button>
			</form>
			<noscript><p class="ebook-noscript">搜索与格式筛选需要 JavaScript；分类和页码可直接使用。</p></noscript>
		{categories.length > 0 && <details class="ebook-classification">
			<summary>分类 <span>{label}</span></summary>
			<nav aria-label="中图分类">
				<a href="/ebooks/" aria-current={!category && !booklist ? 'page' : undefined}>全部藏书 <span>{booksInCategory(all).length}</span></a>
				{categories.map(item => <a href={ebookShelfHref(1, item.code)} aria-current={!booklist && item.code === category ? 'page' : undefined}>{item.code} · {item.label} <span>{item.count}</span></a>)}
			</nav>
		</details>}
		</div>
		{booklist && <nav class="ebook-breadcrumb" aria-label="书单路径"><a href="/ebooks/">全部藏书</a><span> / </span><a href={ebookShelfHref(1, booklist[0])}>{LIBRARY_CLASSES[booklist[0]]}</a><span> / {label}</span></nav>}
		{booklists.length > 0 && <section class="ebook-booklists" aria-labelledby="ebook-booklists-title">
			<h2 id="ebook-booklists-title">书单 <span>Booklists</span></h2>
			<nav aria-label="中图细分类书单">{booklists.map(list => {
				const covers = all.filter(book => book.clcCode === list.code && !book.categoryOnly && book.cover).slice(0, 2);
				return <a class="ebook-booklist" href={ebookShelfHref(1, undefined, list.code)}>
					<span class="ebook-booklist__folder" aria-hidden="true">{covers.map(book => <img src={book.cover} width="60" height="90" alt="" loading="lazy" decoding="async" />)}<span>{list.code}</span></span>
					<span>{list.label}<small>{list.code} · {list.count} 份</small></span>
				</a>;
			})}</nav>
		</section>}
		<p class="ebook-sr-only" role="status" aria-live="polite" data-search-status></p>
		<ul class="ebook-grid" aria-label="藏书" data-shelf-grid>{items.map(book => <li><EbookCard book={book} /></li>)}</ul>
		<p class="ebook-empty" data-shelf-empty hidden={books.length > 0}>{books.length ? '没有找到匹配的藏书。' : booklists.length ? '请从上方书单进入浏览。' : copy.empty}</p>
		<EbookPagination page={page} pageCount={pageCount} total={total} category={category} booklist={booklist} />
	</main>
</Layout>
<script>
	import { initEbookShelf } from '../../lib/ebooks/shelfClient';
	initEbookShelf();
</script>
