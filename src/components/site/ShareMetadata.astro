---
import { SITE_CONFIG } from '../../config/site';
import { resolveCanonicalUrl, resolveShareImage } from '../../lib/shareMetadata';
import { buildStructuredData, serializeStructuredData, type ArticleMetadata } from '../../lib/structuredData';

type Props = {
	title: string;
	description: string;
	image?: string;
	imageAlt?: string;
	article?: ArticleMetadata;
};
const { title, description, image, imageAlt, article } = Astro.props;
if (!Astro.site) throw new Error('Sharing metadata requires Astro site configuration.');
const canonical = resolveCanonicalUrl(Astro.url.pathname, Astro.site);
const shareImage = resolveShareImage(image, Astro.site, imageAlt);
const structuredData = buildStructuredData({
	site: Astro.site, pathname: Astro.url.pathname, title, description,
	// A fallback author avatar is useful for sharing, but is not an article illustration.
	image: image && shareImage.url !== SITE_CONFIG.shareImage.url ? shareImage.url : undefined,
	article,
});
---

<link rel="canonical" href={canonical} />
<script type="application/ld+json" set:html={serializeStructuredData(structuredData)} />
<meta property="og:site_name" content={SITE_CONFIG.name} />
<meta property="og:locale" content="zh_CN" />
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={shareImage.url} />
<meta property="og:image:alt" content={shareImage.alt} />
{shareImage.width && <meta property="og:image:width" content={String(shareImage.width)} />}
{shareImage.height && <meta property="og:image:height" content={String(shareImage.height)} />}
{shareImage.type && <meta property="og:image:type" content={shareImage.type} />}
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={shareImage.url} />
<meta name="twitter:image:alt" content={shareImage.alt} />
{article && <>
	<meta property="article:published_time" content={article.publishedAt.toISOString()} />
	<meta property="article:modified_time" content={article.updatedAt.toISOString()} />
	{article.tags.map(tag => <meta property="article:tag" content={tag} />)}
</>}
