<div
	class="page-scroll-indicator"
	role="slider"
	tabindex="0"
	aria-label="Page scroll position"
	aria-orientation="vertical"
	aria-valuemin="0"
	aria-valuemax="100"
	aria-valuenow="0"
	hidden
>
	<span></span>
</div>

<script>
	import { scrollToTarget } from '../../lib/scrollRuntime';

	const IDLE_DELAY = 920;
	const MIN_SCROLL_DISTANCE = 80;
	const clampProgress = (value: number) => Math.min(1, Math.max(0, value));
	const root = document.documentElement;
	const track = document.querySelector<HTMLDivElement>('.page-scroll-indicator');
	const fill = track?.querySelector('span');
	if (track && fill) {
		let progress = 0;
		let percent = 0;
		let idleTimer: number | undefined;
		let frame: number | undefined;
		let drag: { pointerId: number; top: number; height: number } | undefined;
		const getScrollableDistance = () => root.scrollHeight - innerHeight;

		const paintProgress = (value: number) => {
			if (progress === value) return;
			progress = value;
			fill.style.setProperty('--scroll-progress', String(value));
			const nextPercent = Math.round(value * 100);
			if (nextPercent === percent) return;
			percent = nextPercent;
			track.setAttribute('aria-valuenow', String(percent));
		};
		const showBriefly = () => {
			track.classList.add('is-visible');
			clearTimeout(idleTimer);
			if (!drag) idleTimer = window.setTimeout(() => track.classList.remove('is-visible'), IDLE_DELAY);
		};
		const scrollToProgress = (value: number) => {
			const distance = getScrollableDistance();
			if (distance <= MIN_SCROLL_DISTANCE) return;
			const next = clampProgress(value);
			paintProgress(next);
			showBriefly();
			scrollToTarget(distance * next, { immediate: !!drag });
		};
		const requestUpdate = () => {
			if (frame !== undefined) return;
			frame = requestAnimationFrame(() => {
				frame = undefined;
				const distance = getScrollableDistance();
				track.hidden = distance <= MIN_SCROLL_DISTANCE;
				if (track.hidden) return;
				paintProgress(clampProgress(scrollY / distance));
				showBriefly();
			});
		};
		track.addEventListener('pointerdown', event => {
			if (drag || !event.isPrimary || event.button !== 0 || getScrollableDistance() <= MIN_SCROLL_DISTANCE) return;
			const { top, height } = track.getBoundingClientRect();
			if (height <= 0) return;
			event.preventDefault();
			drag = { pointerId: event.pointerId, top, height };
			track.setPointerCapture(event.pointerId);
			track.classList.add('is-dragging');
			root.classList.add('is-page-scroll-dragging');
			scrollToProgress((event.clientY - top) / height);
		});
		track.addEventListener('pointermove', event => {
			if (drag?.pointerId === event.pointerId) scrollToProgress((event.clientY - drag.top) / drag.height);
		});
		const finishDrag = (event: PointerEvent) => {
			if (drag?.pointerId !== event.pointerId) return;
			drag = undefined;
			track.classList.remove('is-dragging');
			root.classList.remove('is-page-scroll-dragging');
			showBriefly();
		};
		for (const type of ['pointerup', 'pointercancel', 'lostpointercapture'] as const) track.addEventListener(type, finishDrag);
		track.addEventListener('keydown', event => {
			const step = event.shiftKey ? 0.16 : 0.08;
			const next = { Home: 0, End: 1, ArrowUp: progress - step, PageUp: progress - step, ArrowDown: progress + step, PageDown: progress + step };
			if (!Object.hasOwn(next, event.key)) return;
			event.preventDefault();
			scrollToProgress(next[event.key as keyof typeof next]);
		});
		addEventListener('scroll', requestUpdate, { passive: true });
		addEventListener('resize', requestUpdate);
		new ResizeObserver(requestUpdate).observe(document.body);
		requestUpdate();
	}
</script>
