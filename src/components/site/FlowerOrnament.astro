---
import '../../styles/flower-ornament.css';
type Props = { tone?: 'rose' | 'lilac' | 'ivory' };
const { tone = 'rose' } = Astro.props;
---

<span class="ornamented-text"><slot /><svg
	class:list={['flower-ornament', `flower-ornament--${tone}`]}
	viewBox="0 0 26 20"
	aria-hidden="true"
	focusable="false"
	data-flower-ornament
>
	<path data-petal="1" d="M1 17c.1-2.6 2.4-4.5 5.2-4.7l-.3 1.5 1.6.1C6.6 16.5 3.7 17.7 1 17Z" />
	<path data-petal="2" d="M9 10.4c-.4-2.3 1.6-4.9 4.6-5.9l-.4 1.4 1.5-.1C14 8.1 11.5 10.3 9 10.4Z" />
	<path data-petal="3" d="M16.7 14c1.1-1.7 3.8-2.1 5.5-.9-1.4 1.4-4.1 1.9-5.5.9Z" />
	<path data-petal="4" d="M21 5.2c0-1.5 1.5-3.2 3.7-3.3-.3 1.8-1.9 3.2-3.7 3.3Z" />
</svg></span>

<script>
	if ('IntersectionObserver' in window) {
		const observer = new IntersectionObserver(entries => {
			for (const entry of entries) {
				if (!entry.isIntersecting) continue;
				entry.target.classList.add('is-blooming');
				observer.unobserve(entry.target);
			}
		}, { threshold: .25 });
		for (const flower of document.querySelectorAll('[data-flower-ornament]')) observer.observe(flower);
	}
</script>
