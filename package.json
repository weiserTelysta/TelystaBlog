{
  "name": "telystablogproject",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run content:check && npm run score:check && astro dev",
    "build": "astro build",
    "prebuild": "npm run content:check && npm run score:check",
    "assets:prepare": "node scripts/prepare-cdn-assets.mjs",
    "assets:manifest": "node scripts/generate-cdn-manifest.mjs",
    "assets:sync": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sync-r2-assets.ps1",
    "post:new": "tsx scripts/create-post.ts",
    "content:check": "tsx scripts/validate-content.ts",
    "score:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-score-tools.ps1",
    "score:render": "node scripts/render-score.mjs",
    "score:check": "node scripts/render-score.mjs --check",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "astro check && tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/react": "^6.0.2",
    "astro": "^7.2.2",
    "katex": "^0.17.0",
    "lenis": "^1.3.23",
    "motion": "^12.42.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sass": "^1.100.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^22.20.1",
    "sharp": "^0.35.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "yaml": "^2.9.0"
  }
}
